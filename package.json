{
  "name": "muse-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "muse-bridge": "dist/src/cli.js",
    "passeur": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run test:core && vitest run",
    "test:watch": "vitest",
    "test:core": "tsc -p tsconfig.core.json && node --test --test-concurrency=1 tests/core/*.test.mjs",
    "probe:wait": "tsx scripts/probe-wait.ts",
    "probe:muse": "tsx scripts/probe-muse.ts",
    "probe:parallel": "node dist/scripts/probe-parallel.js",
    "build:runtime": "tsx scripts/build-runtime.ts",
    "probe:installed": "tsx scripts/probe-installed.ts",
    "test:installed": "npm run build && vitest run tests/integration/mcp-startup.test.ts tests/integration/installed-runtime.test.ts tests/integration/registration-probe.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@muse-code/sdk": "1.3.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.1.11",
    "smol-toml": "1.6.1"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
