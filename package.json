{
  "name": "muse-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "muse-bridge": "dist/src/cli.js",
    "passeur": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run test:core && npm run test:native && vitest run",
    "test:watch": "vitest",
    "test:core": "tsc -p tsconfig.core.json && node --test --test-concurrency=1 tests/core/*.test.mjs",
    "probe:wait": "tsx scripts/probe-wait.ts",
    "probe:muse": "tsx scripts/probe-muse.ts",
    "probe:parallel": "node dist/scripts/probe-parallel.js",
    "build:runtime": "tsx scripts/build-runtime.ts",
    "probe:installed": "tsx scripts/probe-installed.ts",
    "test:installed": "npm run build && vitest run tests/integration/mcp-startup.test.ts tests/integration/installed-runtime.test.ts tests/integration/registration-probe.test.ts",
    "test:native": "tsc -p tsconfig.native.json && node --test tests/native/*.test.mjs",
    "probe:agents": "node dist/scripts/probe-agents.js",
    "probe:service": "node dist/scripts/probe-service.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@muse-code/sdk": "1.3.0",
    "proper-lockfile": "4.1.2",
    "smol-toml": "1.8.0",
    "tree-sitter": "0.25.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@tree-sitter-grammars/tree-sitter-kotlin": "file:vendor/native-grammars/tree-sitter-grammars-tree-sitter-kotlin-1.1.0.tgz",
    "@tree-sitter-grammars/tree-sitter-lua": "0.4.1",
    "@tree-sitter-grammars/tree-sitter-svelte": "1.0.2",
    "@types/node": "24.7.2",
    "@types/proper-lockfile": "4.1.4",
    "tree-sitter-c": "file:vendor/native-grammars/tree-sitter-c-0.24.2.tgz",
    "tree-sitter-c-sharp": "file:vendor/native-grammars/tree-sitter-c-sharp-0.23.5.tgz",
    "tree-sitter-cpp": "file:vendor/native-grammars/tree-sitter-cpp-0.23.4.tgz",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-odin": "1.3.0",
    "tree-sitter-python": "file:vendor/native-grammars/tree-sitter-python-0.25.0.tgz",
    "tree-sitter-rust": "file:vendor/native-grammars/tree-sitter-rust-0.24.2.tgz",
    "tree-sitter-typescript": "0.23.2",
    "tree-sitter-zig": "https://codeload.github.com/tree-sitter-grammars/tree-sitter-zig/tar.gz/6479aa13f32f701c383083d8b28360ebd682fb7d",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
