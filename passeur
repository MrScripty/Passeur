#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cli="$repo_root/dist/src/cli.js"

if [[ ! -f "$cli" ]]; then
  echo "Passeur is not built. Run: npm install && npm run build" >&2
  exit 1
fi

command="${1:-start}"
case "$command" in
  start|setup|configure|doctor|inspect|result|logs|finalize|cleanup|reconcile) shift || true ;;
  *) command="start" ;;
esac

project="$PWD"
if [[ $# -gt 0 && "$1" != -* ]]; then project="$1"; shift; fi
if [[ "$command" == "start" ]]; then command="serve"; fi

exec node "$cli" "$command" --project "$project" "$@"
